---
import type { UITranslations } from '../i18n/ui';
import type { Locale } from '../i18n/config';
import { aboutPath } from '../i18n/paths';

interface Props {
  t: UITranslations;
  locale: Locale;
  siteTitle: string;
  domain: string;
  email: string;
  github: string;
}

const { t, locale, siteTitle, domain, email, github } = Astro.props;
const year = new Date().getFullYear();
const aboutHref = aboutPath(locale);
---

<footer class="mt-auto container-main py-12">
  <div
    class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs pt-8"
    style="border-top: 1px solid var(--crt-border-dim); color: var(--crt-text-muted);"
  >
    <p class="leading-relaxed">
      <span style="color: var(--crt-text);">{siteTitle}</span>
      <span> · © {year}{domain ? ` ${domain}` : ''}</span>
    </p>

    <div class="flex items-center gap-4">
      <a href={aboutHref} class="hover:opacity-70 transition-opacity duration-150" style="color: var(--crt-accent);">
        {t.footer.about}
      </a>
      <a href={`mailto:${email}`} class="hover:opacity-70 transition-opacity duration-150" style="color: var(--crt-accent);">
        {t.footer.contact}
      </a>
      <a
        href={github}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:opacity-70 transition-opacity duration-150"
        style="color: var(--crt-accent);"
      >
        {t.footer.github}
      </a>
    </div>
  </div>
</footer>
