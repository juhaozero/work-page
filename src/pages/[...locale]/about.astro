---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import DetailBoot from '../../components/DetailBoot';
import { locales, getLocaleParam, type Locale } from '../../i18n/config';
import { getTranslations } from '../../i18n/ui';
import { homePath } from '../../i18n/paths';
import site from '../../data/site.json';

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale: getLocaleParam(locale) },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };
const t = getTranslations(locale);
const homeHref = homePath(locale);
const host = site.seo?.author ?? site.title;
const stackShort = 'Astro · React · Tailwind';
const localeLabel = locale === 'zh' ? 'zh-CN' : 'en-US';
---

<BaseLayout
  locale={locale}
  t={t}
  path="/about"
  title={`${t.about.title} · ${site.title}`}
  description={t.about.seoDescription}
>
  <main class="flex-1 w-full">
    <section class="container-main pt-24 sm:pt-28 pb-20">
      <div class="max-w-2xl mx-auto">
        <DetailBoot prompt={t.crt.prompt} command={t.about.whoamiCommand} client:load />

        <div class="crt-detail-body">
          <a
            href={homeHref}
            class="text-xs mb-8 inline-block hover:opacity-70 transition-opacity duration-150"
            style="color: var(--crt-accent);"
          >
            {t.about.backHome}
          </a>

          <p class="terminal-label mb-3">{t.nav.about}</p>
          <h1 class="text-xl sm:text-2xl font-medium text-balance mb-8">{t.about.title}</h1>

          <dl class="mb-10 space-y-2.5">
            <div class="crt-meta-row">
              <dt class="crt-meta-label">{t.about.metaHost}</dt>
              <dd class="crt-meta-value">{host}</dd>
            </div>
            <div class="crt-meta-row">
              <dt class="crt-meta-label">{t.about.metaStack}</dt>
              <dd class="crt-meta-value">{stackShort}</dd>
            </div>
            <div class="crt-meta-row">
              <dt class="crt-meta-label">{t.about.metaLocale}</dt>
              <dd class="crt-meta-value">{localeLabel}</dd>
            </div>
          </dl>

          <div class="space-y-10 text-sm leading-relaxed">
            <section class="space-y-3">
              <h2 class="text-base font-medium">{t.about.introTitle}</h2>
              <p class="text-pretty" style="color: var(--crt-text-muted);">{t.about.introBody}</p>
            </section>

            <section class="space-y-3">
              <h2 class="text-base font-medium">{t.about.stackTitle}</h2>
              <p class="text-pretty" style="color: var(--crt-text-muted);">{t.about.stackBody}</p>
            </section>

            <section class="space-y-3">
              <h2 class="text-base font-medium">{t.about.nowTitle}</h2>
              <ul class="space-y-2" style="color: var(--crt-text-muted);">
                {t.about.nowItems.map((item) => (
                  <li class="flex gap-2">
                    <span style="color: var(--crt-text-dim);" aria-hidden="true">·</span>
                    <span class="text-pretty">{item}</span>
                  </li>
                ))}
              </ul>
            </section>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer
    t={t}
    locale={locale}
    siteTitle={site.title}
    domain={site.domain}
    email={site.email}
    github={site.github}
  />
</BaseLayout>
