---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Footer from "../../../components/Footer.astro";
import ProjectHealthInit from "../../../components/ProjectHealthInit";
import ProjectStatus from "../../../components/ProjectStatus";
import { IconGithub, IconLink } from "../../../components/PortalIcons";
import {
  locales,
  getLocaleParam,
  localeHtmlLang,
  type Locale,
} from "../../../i18n/config";
import { getTranslations, t as format } from "../../../i18n/ui";
import { getProjects } from "../../../i18n/projects";
import { homePath, projectDetailPath } from "../../../i18n/paths";
import { projectCoverImage, projectOgImage } from "../../../lib/projectCover";
import {
  getPrimaryAction,
  getProjectKind,
} from "../../../lib/projectAccess";
import DetailBoot from "../../../components/DetailBoot";
import site from "../../../data/site.json";
import healthReport from "../../../data/status.json";
import type { HealthReport, Project } from "../../../types/project";

export function getStaticPaths() {
  return locales.flatMap((locale) => {
    const projects = getProjects(locale);
    return projects.map((project) => ({
      params: {
        locale: getLocaleParam(locale),
        slug: project.slug,
      },
      props: { locale, project },
    }));
  });
}

const { locale, project } = Astro.props as { locale: Locale; project: Project };
const t = getTranslations(locale);
const siteUrl = site.url ?? `https://${site.domain}`;
const report = healthReport as HealthReport;
const homeHref = homePath(locale);
const pagePath = `/projects/${project.slug}`;
const pageUrl = new URL(projectDetailPath(locale, project.slug), siteUrl).href;
const ogImage = projectOgImage(project);
const longCopy = project.longDescription ?? project.description;
const cols = t.catalog.columns;
const kind = getProjectKind(project);
const primaryAction = getPrimaryAction(project);
const primaryLabel =
  primaryAction?.action === "download"
    ? t.project.downloadLabel
    : t.project.openLabel;

const secondaryLinks = [
  project.url && kind === "package"
    ? { href: project.url, label: t.project.openLabel, Icon: IconLink }
    : null,
  project.demo && project.demo !== project.url
    ? { href: project.demo, label: t.project.demo, Icon: IconLink }
    : null,
  project.docs ? { href: project.docs, label: t.project.docs, Icon: IconLink } : null,
  project.changelog
    ? { href: project.changelog, label: t.project.changelog, Icon: IconLink }
    : null,
  project.repo ? { href: project.repo, label: t.project.repo, Icon: IconGithub } : null,
].filter((link) => link !== null);

const coverImage = projectCoverImage(project);
const coverAlt = format(t.project.coverAlt, { name: project.name });
const osLabel = kind === "package" ? "Any" : "Web";

const softwareJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: project.name,
  description: longCopy,
  url: pageUrl,
  applicationCategory: project.category,
  operatingSystem: osLabel,
  inLanguage: localeHtmlLang[locale],
  image: new URL(ogImage, siteUrl).href,
  ...(project.createdAt ? { dateCreated: project.createdAt } : {}),
  ...(project.version ? { softwareVersion: project.version } : {}),
  ...(project.tech?.length ? { keywords: project.tech.join(", ") } : {}),
  ...(primaryAction?.action === "download"
    ? { downloadUrl: primaryAction.href }
    : {}),
  ...(primaryAction?.action === "open" ? { sameAs: primaryAction.href } : {}),
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "CNY",
  },
  author: {
    "@type": "Person",
    name: t.site.seo.author,
    url: site.github,
  },
};

const health = report.projects[project.id];
const reasonLabel = health ? t.status.reason[health.reason] : null;
const checkedAtLabel =
  report.checkedAt && report.checkedAt !== "1970-01-01T00:00:00.000Z"
    ? format(t.status.checkedAt, {
        time: new Date(report.checkedAt).toLocaleString(
          locale === "zh" ? "zh-CN" : "en-US",
        ),
      })
    : null;
const lifecycleLabel = project.lifecycle
  ? t.project.lifecycle[project.lifecycle]
  : null;
const technologies = project.tech ?? [];
const detailCommand = format(t.crt.detailCommand, { slug: project.slug });

const metadata = [
  { label: cols.category, value: project.category },
  { label: t.project.kindLabel, value: t.project.kind[kind] },
  project.version
    ? { label: t.project.versionLabel, value: project.version }
    : null,
  lifecycleLabel
    ? { label: t.project.lifecycleLabel, value: lifecycleLabel }
    : null,
].filter((item) => item !== null);
---

<BaseLayout
  locale={locale}
  t={t}
  path={pagePath}
  title={`${project.name} · ${site.title}`}
  description={project.description}
  ogImage={ogImage}
  jsonLd={softwareJsonLd}>
  <ProjectHealthInit projects={[project]} initialReport={report} client:load />

  <main class="flex-1 w-full">
    <article class="container-main pt-24 sm:pt-28 pb-20">
      <div class="mx-auto max-w-[70rem]">
        <div class="project-detail-command">
          <DetailBoot prompt={t.crt.prompt} command={detailCommand} client:load />
        </div>

        <div class="crt-detail-body">
          <a href={homeHref} class="project-detail-back">
            {t.project.backToCatalog}
          </a>

          <div class="project-detail-grid">
            <div class="min-w-0">
              <header>
                <h1 class="project-detail-title text-balance">{project.name}</h1>
                <p class="project-detail-description text-pretty">{project.description}</p>
                {
                  primaryAction && (
                    <a
                      href={primaryAction.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class:list={[
                        "portal-link project-detail-action",
                        { "project-detail-action-open": primaryAction.action === "open" },
                      ]}
                    >
                      {primaryLabel}
                    </a>
                  )
                }
              </header>

              <div class="project-detail-card">
                <section class="space-y-3">
                  <h2 class="project-detail-summary">
                    <span aria-hidden="true">#</span> {t.project.summaryLabel}
                  </h2>
                  <p class="project-detail-copy text-pretty">{longCopy}</p>
                </section>

                {
                  coverImage ? (
                    <img
                      src={coverImage}
                      alt={coverAlt}
                      width={1200}
                      height={630}
                      class="project-detail-preview w-full aspect-[16/9] object-cover"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <div class="project-detail-preview project-detail-placeholder">
                      <code>{t.project.previewPlaceholder}</code>
                    </div>
                  )
                }

                {
                  secondaryLinks.length > 0 && (
                    <section class="space-y-2">
                      <h2 class="project-detail-section-title">{t.project.linksLabel}</h2>
                      <ul class="flex flex-wrap gap-1.5">
                        {secondaryLinks.map(({ href, label, Icon }) => (
                          <li>
                            <a href={href} target="_blank" rel="noopener noreferrer" class="portal-link">
                              <Icon className="shrink-0" />
                              {label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </section>
                  )
                }
              </div>
            </div>

            <aside class="project-detail-sidebar" aria-labelledby="project-information">
              <div class="space-y-3">
                <h2 id="project-information" class="project-detail-section-title">{t.project.metadataLabel}</h2>
                <dl class="flex flex-wrap gap-2">
                  {metadata.map(({ label, value }) => (
                    <div class="project-detail-badge">
                      <dt>{label}</dt>
                      <dd>{value}</dd>
                    </div>
                  ))}
                </dl>
              </div>

              {
                technologies.length > 0 && (
                  <section class="space-y-3">
                    <h3 class="project-detail-section-title">{cols.tech}</h3>
                    <ul class="flex flex-wrap gap-1.5">
                      {technologies.map((tech) => <li class="tech-tag">{tech}</li>)}
                    </ul>
                  </section>
                )
              }

              <section class="space-y-3">
                <h3 class="project-detail-section-title">{cols.status}</h3>
                <div class="project-detail-status">
                  <ProjectStatus projectId={project.id} labels={t.status} kind={kind} client:load />
                </div>
                {
                  (checkedAtLabel || reasonLabel || (health?.error && !health.online)) && (
                    <p class="project-detail-check">
                      {checkedAtLabel && <span>{checkedAtLabel}</span>}
                      {reasonLabel && <span>{reasonLabel}</span>}
                      {health?.error && !health.online && <span>{health.error}</span>}
                    </p>
                  )
                }
              </section>
            </aside>
          </div>
        </div>
      </div>
    </article>
  </main>

  <Footer
    t={t}
    locale={locale}
    siteTitle={site.title}
    domain={site.domain}
    email={site.email}
    github={site.github}
  />
</BaseLayout>
