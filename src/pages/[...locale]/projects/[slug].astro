---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Footer from "../../../components/Footer.astro";
import ProjectHealthInit from "../../../components/ProjectHealthInit";
import ProjectStatus from "../../../components/ProjectStatus";
import {
  locales,
  getLocaleParam,
  localeHtmlLang,
  type Locale,
} from "../../../i18n/config";
import { getTranslations, t as format } from "../../../i18n/ui";
import { getProjects } from "../../../i18n/projects";
import { homePath, projectDetailPath } from "../../../i18n/paths";
import { projectCoverImage, projectOgImage } from "../../../lib/projectCover";
import {
  getPrimaryAction,
  getProjectKind,
  releasePlatformsLabel,
} from "../../../lib/projectAccess";
import DetailBoot from "../../../components/DetailBoot";
import site from "../../../data/site.json";
import healthReport from "../../../data/status.json";
import type { HealthReport, Project } from "../../../types/project";

export function getStaticPaths() {
  return locales.flatMap((locale) => {
    const projects = getProjects(locale);
    return projects.map((project) => ({
      params: {
        locale: getLocaleParam(locale),
        slug: project.slug,
      },
      props: { locale, project },
    }));
  });
}

const { locale, project } = Astro.props as { locale: Locale; project: Project };
const t = getTranslations(locale);
const siteUrl = site.url ?? `https://${site.domain}`;
const report = healthReport as HealthReport;
const homeHref = homePath(locale);
const pagePath = `/projects/${project.slug}`;
const pageUrl = new URL(projectDetailPath(locale, project.slug), siteUrl).href;
const ogImage = projectOgImage(project);
const longCopy = project.longDescription ?? project.description;
const cols = t.catalog.columns;
const kind = getProjectKind(project);
const primaryAction = getPrimaryAction(project);
const primaryLabel =
  primaryAction?.action === "download"
    ? t.project.downloadLabel
    : t.project.openLabel;

const secondaryLinks = [
  project.url && kind === "package"
    ? { href: project.url, label: t.project.openLabel }
    : null,
  project.demo && project.demo !== project.url
    ? { href: project.demo, label: t.project.demo }
    : null,
  project.docs ? { href: project.docs, label: t.project.docs } : null,
  project.changelog
    ? { href: project.changelog, label: t.project.changelog }
    : null,
  project.repo ? { href: project.repo, label: t.project.repo } : null,
].filter(Boolean) as { href: string; label: string }[];

const releases = project.releases ?? [];
const coverImage = projectCoverImage(project);
const coverAlt = format(t.project.coverAlt, { name: project.name });
const osLabel =
  kind === "package"
    ? releasePlatformsLabel(releases.map((r) => r.platform))
    : "Web";

const softwareJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: project.name,
  description: longCopy,
  url: pageUrl,
  applicationCategory: project.category,
  operatingSystem: osLabel,
  inLanguage: localeHtmlLang[locale],
  image: new URL(ogImage, siteUrl).href,
  ...(project.createdAt ? { dateCreated: project.createdAt } : {}),
  ...(project.version ? { softwareVersion: project.version } : {}),
  ...(project.tech?.length ? { keywords: project.tech.join(", ") } : {}),
  ...(primaryAction?.action === "download"
    ? { downloadUrl: primaryAction.href }
    : {}),
  ...(primaryAction?.action === "open" ? { sameAs: primaryAction.href } : {}),
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "CNY",
  },
  author: {
    "@type": "Person",
    name: t.site.seo.author,
    url: site.github,
  },
};

const health = report.projects[project.id];
const reasonLabel = health ? t.status.reason[health.reason] : null;
const checkedAtLabel =
  report.checkedAt && report.checkedAt !== "1970-01-01T00:00:00.000Z"
    ? format(t.status.checkedAt, {
        time: new Date(report.checkedAt).toLocaleString(
          locale === "zh" ? "zh-CN" : "en-US",
        ),
      })
    : null;
const lifecycleLabel = project.lifecycle
  ? t.project.lifecycle[project.lifecycle]
  : null;
const techLine =
  project.tech && project.tech.length > 0 ? project.tech.join(" · ") : null;
const detailCommand = format(t.crt.detailCommand, { slug: project.slug });

const metaRows = [
  { label: cols.category, value: project.category },
  { label: t.project.kindLabel, value: t.project.kind[kind] },
  project.version
    ? { label: t.project.versionLabel, value: project.version }
    : null,
  lifecycleLabel
    ? { label: t.project.lifecycleLabel, value: lifecycleLabel }
    : null,
  techLine ? { label: cols.tech, value: techLine } : null,
].filter(Boolean) as { label: string; value: string }[];
---

<BaseLayout
  locale={locale}
  t={t}
  path={pagePath}
  title={`${project.name} · ${site.title}`}
  description={project.description}
  ogImage={ogImage}
  jsonLd={softwareJsonLd}>
  <ProjectHealthInit projects={[project]} initialReport={report} client:load />

  <main class="flex-1 w-full">
    <article class="container-main pt-24 sm:pt-28 pb-20">
      <div class="max-w-2xl mx-auto">
        <DetailBoot prompt={t.crt.prompt} command={detailCommand} client:load />

        <div class="crt-detail-body">
          <a
            href={homeHref}
            class="text-xs mb-8 inline-block hover:opacity-70 transition-opacity duration-150"
            style="color: var(--crt-accent);">
            {t.project.backToCatalog}
          </a>

          <header class="mb-10">
            {
              coverImage && (
                <div class="mb-6 overflow-hidden border border-[var(--crt-border)] bg-[var(--crt-surface)]">
                  <img
                    src={coverImage}
                    alt={coverAlt}
                    width={1200}
                    height={630}
                    class="w-full aspect-[16/9] object-cover"
                    loading="eager"
                    decoding="async"
                  />
                </div>
              )
            }
            <h1 class="text-lg sm:text-xl font-semibold tracking-tight text-balance">
              {project.name}
            </h1>
            <p
              class="text-sm mt-2 leading-relaxed text-pretty"
              style="color: var(--crt-text-muted);">
              {project.description}
            </p>
            {
              primaryAction && (
                <div class="mt-5">
                  <a
                    href={primaryAction.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-terminal-primary"
                  >
                    {primaryLabel}
                  </a>
                </div>
              )
            }
          </header>

          <dl class="mb-10 space-y-2.5">
            {
              metaRows.map((row) => (
                <div class="crt-meta-row">
                  <dt class="crt-meta-label">{row.label}</dt>
                  <dd class="crt-meta-value">{row.value}</dd>
                </div>
              ))
            }
            <div class="crt-meta-row">
              <dt class="crt-meta-label">{cols.status}</dt>
              <dd class="crt-meta-value">
                <ProjectStatus
                  projectId={project.id}
                  labels={t.status}
                  kind={kind}
                  client:load
                />
              </dd>
            </div>
          </dl>

          {
            (checkedAtLabel ||
              reasonLabel ||
              (health?.error && !health.online)) && (
              <p
                class="text-xs mb-8 space-x-3"
                style="color: var(--crt-text-dim);">
                {checkedAtLabel && <span>{checkedAtLabel}</span>}
                {reasonLabel && <span>· {reasonLabel}</span>}
                {health?.error && !health.online && (
                  <span>· {health.error}</span>
                )}
              </p>
            )
          }

          <section class="mb-10 space-y-3">
            <h2 class="terminal-label">{t.project.summaryLabel}</h2>
            <p
              class="text-sm leading-relaxed text-pretty"
              style="color: var(--crt-text-muted);">
              {longCopy}
            </p>
          </section>

          {
            releases.length > 0 && (
              <section class="mb-10">
                <h2 class="terminal-label mb-3">{t.project.releasesLabel}</h2>
                <ul class="space-y-2.5">
                  {releases.map((release) => {
                    const platformName =
                      release.label ?? t.project.platforms[release.platform];
                    const meta = [
                      platformName,
                      release.version,
                      release.size,
                    ]
                      .filter(Boolean)
                      .join(" · ");
                    return (
                      <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-sm">
                        <a
                          href={release.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="min-h-[44px] inline-flex items-center transition-opacity duration-150 hover:opacity-70 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--crt-accent)] cursor-pointer"
                          style="color: var(--crt-accent);"
                        >
                          {release.filename}
                          <span class="ml-2 opacity-70" aria-hidden="true">
                            ↓
                          </span>
                        </a>
                        {meta && (
                          <span style="color: var(--crt-text-dim);">{meta}</span>
                        )}
                        {release.sha256 && (
                          <code
                            class="w-full text-xs break-all"
                            style="color: var(--crt-text-dim);"
                          >
                            sha256:{release.sha256}
                          </code>
                        )}
                      </li>
                    );
                  })}
                </ul>
              </section>
            )
          }

          {
            secondaryLinks.length > 0 && (
              <section>
                <h2 class="terminal-label mb-3">{t.project.linksLabel}</h2>
                <ul class="space-y-2.5">
                  {secondaryLinks.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-sm transition-opacity duration-150 hover:opacity-70 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--crt-accent)] cursor-pointer"
                        style="color: var(--crt-accent);"
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }
        </div>
      </div>
    </article>
  </main>

  <Footer
    t={t}
    locale={locale}
    siteTitle={site.title}
    domain={site.domain}
    email={site.email}
    github={site.github}
  />
</BaseLayout>
