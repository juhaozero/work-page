---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Footer from "../../../components/Footer.astro";
import ProjectHealthInit from "../../../components/ProjectHealthInit";
import ProjectStatus from "../../../components/ProjectStatus";
import {
  locales,
  getLocaleParam,
  localeHtmlLang,
  type Locale,
} from "../../../i18n/config";
import { getTranslations, t as format } from "../../../i18n/ui";
import { getProjects } from "../../../i18n/projects";
import { homePath, projectDetailPath } from "../../../i18n/paths";
import { projectCoverImage, projectOgImage } from "../../../lib/projectCover";
import DetailBoot from "../../../components/DetailBoot";
import site from "../../../data/site.json";
import healthReport from "../../../data/status.json";
import type { HealthReport, Project } from "../../../types/project";

export function getStaticPaths() {
  return locales.flatMap((locale) => {
    const projects = getProjects(locale);
    return projects.map((project) => ({
      params: {
        locale: getLocaleParam(locale),
        slug: project.slug,
      },
      props: { locale, project },
    }));
  });
}

const { locale, project } = Astro.props as { locale: Locale; project: Project };
const t = getTranslations(locale);
const siteUrl = site.url ?? `https://${site.domain}`;
const report = healthReport as HealthReport;
const homeHref = homePath(locale);
const pagePath = `/projects/${project.slug}`;
const pageUrl = new URL(projectDetailPath(locale, project.slug), siteUrl).href;
const ogImage = projectOgImage(project);
const longCopy = project.longDescription ?? project.description;
const cols = t.catalog.columns;

const links = [
  { href: project.url, label: t.project.openLabel, primary: true as const },
  project.demo && project.demo !== project.url
    ? { href: project.demo, label: t.project.demo, primary: false as const }
    : null,
  project.docs ? { href: project.docs, label: t.project.docs, primary: false as const } : null,
  project.changelog
    ? { href: project.changelog, label: t.project.changelog, primary: false as const }
    : null,
  project.repo ? { href: project.repo, label: t.project.repo, primary: false as const } : null,
].filter(Boolean) as { href: string; label: string; primary: boolean }[];

const primaryLink = links.find((link) => link.primary) ?? links[0];
const secondaryLinks = links.filter((link) => link !== primaryLink);
const coverImage = projectCoverImage(project);
const coverAlt = format(t.project.coverAlt, { name: project.name });
const softwareJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: project.name,
  description: longCopy,
  url: pageUrl,
  applicationCategory: project.category,
  operatingSystem: "Web",
  inLanguage: localeHtmlLang[locale],
  image: new URL(ogImage, siteUrl).href,
  ...(project.createdAt ? { dateCreated: project.createdAt } : {}),
  ...(project.tech?.length ? { keywords: project.tech.join(", ") } : {}),
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "CNY",
  },
  author: {
    "@type": "Person",
    name: t.site.seo.author,
    url: site.github,
  },
};

const health = report.projects[project.id];
const reasonLabel = health ? t.status.reason[health.reason] : null;
const checkedAtLabel =
  report.checkedAt && report.checkedAt !== "1970-01-01T00:00:00.000Z"
    ? format(t.status.checkedAt, {
        time: new Date(report.checkedAt).toLocaleString(
          locale === "zh" ? "zh-CN" : "en-US",
        ),
      })
    : null;
const lifecycleLabel = project.lifecycle
  ? t.project.lifecycle[project.lifecycle]
  : null;
const techLine =
  project.tech && project.tech.length > 0 ? project.tech.join(" · ") : null;
const detailCommand = format(t.crt.detailCommand, { slug: project.slug });

const metaRowClass =
  "flex flex-wrap items-baseline gap-x-4 gap-y-1 sm:gap-x-0 py-3 border-b border-[var(--crt-border-dim)]";
const metaDtClass =
  "shrink-0 text-xs sm:w-[8em] sm:pr-4 terminal-label !normal-case !tracking-normal";
---

<BaseLayout
  locale={locale}
  t={t}
  path={pagePath}
  title={`${project.name} · ${site.title}`}
  description={project.description}
  ogImage={ogImage}
  jsonLd={softwareJsonLd}>
  <ProjectHealthInit projects={[project]} initialReport={report} client:load />

  <main class="flex-1 w-full">
    <article class="container-main pt-24 sm:pt-28 pb-20 max-w-3xl">
      <DetailBoot prompt={t.crt.prompt} command={detailCommand} client:load />

      <div class="crt-detail-body">
        <a href={homeHref} class="btn-terminal mb-8">{t.project.backToCatalog}</a>

        <header class="mb-8">
          {
            coverImage && (
              <div class="mb-6 overflow-hidden border border-[var(--crt-border-dim)] bg-[var(--crt-surface)]">
                <img
                  src={coverImage}
                  alt={coverAlt}
                  width={1200}
                  height={630}
                  class="w-full aspect-[16/9] object-cover"
                  loading="eager"
                  decoding="async"
                />
              </div>
            )
          }
          <h1 class="text-lg sm:text-xl font-semibold tracking-tight text-balance crt-phosphor">
            {project.name}
          </h1>
          <p
            class="text-sm mt-2 leading-snug text-pretty"
            style="color: var(--crt-text-muted);">
            {project.description}
          </p>
          {
            primaryLink && (
              <div class="mt-6">
                <a
                  href={primaryLink.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-terminal-primary"
                >
                  {primaryLink.label}
                </a>
              </div>
            )
          }
        </header>

        <dl class="mb-10 border-t border-[var(--crt-border-dim)]">
          <div class={metaRowClass}>
            <dt class={metaDtClass}>{cols.category}</dt>
            <dd class="text-sm" style="color: var(--crt-text-muted);">
              {project.category}
            </dd>
          </div>
          {
            lifecycleLabel && (
              <div class={metaRowClass}>
                <dt class={metaDtClass}>{t.project.lifecycleLabel}</dt>
                <dd class="text-sm" style="color: var(--crt-text-muted);">
                  {lifecycleLabel}
                </dd>
              </div>
            )
          }
          {
            techLine && (
              <div class={metaRowClass}>
                <dt class={metaDtClass}>{cols.tech}</dt>
                <dd class="text-sm" style="color: var(--crt-text-muted);">
                  {techLine}
                </dd>
              </div>
            )
          }
          <div class={metaRowClass}>
            <dt class={metaDtClass}>{cols.status}</dt>
            <dd class="text-sm">
              <ProjectStatus
                projectId={project.id}
                labels={t.status}
                client:load
              />
            </dd>
          </div>
        </dl>

        {
          (checkedAtLabel ||
            reasonLabel ||
            (health?.error && !health.online)) && (
            <p
              class="text-xs mb-8 space-x-3"
              style="color: var(--crt-text-dim);">
              {checkedAtLabel && <span>{checkedAtLabel}</span>}
              {reasonLabel && <span>· {reasonLabel}</span>}
              {health?.error && !health.online && <span>· {health.error}</span>}
            </p>
          )
        }

        <section class="mb-10 space-y-3">
          <h2 class="terminal-label">{t.project.summaryLabel}</h2>
          <p
            class="text-sm leading-relaxed text-pretty"
            style="color: var(--crt-text-muted);">
            {longCopy}
          </p>
        </section>

        {
          secondaryLinks.length > 0 && (
            <section>
              <h2 class="terminal-label mb-0">{t.project.linksLabel}</h2>
              <ul class="border-t border-[var(--crt-border-dim)] mt-3">
                {secondaryLinks.map((link) => (
                  <li class={metaRowClass}>
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-sm transition-opacity duration-150 hover:opacity-70 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--crt-accent)]"
                      style="color: var(--crt-accent);"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>
    </article>
  </main>

  <Footer
    t={t}
    locale={locale}
    siteTitle={site.title}
    domain={site.domain}
    email={site.email}
    github={site.github}
  />
</BaseLayout>
